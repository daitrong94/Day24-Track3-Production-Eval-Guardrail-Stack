# ── Input Rails ───────────────────────────────────────────────────────────────
# GHI CHÚ: các flow dưới đây dùng execute <action>() (định nghĩa trong actions.py)
# thay vì `user X` canonical-form matching — xem giải thích trong actions.py.

define bot refuse jailbreak
  "Xin lỗi, tôi không thể thực hiện yêu cầu này. Tôi chỉ có thể trả lời các câu hỏi về chính sách nhân sự công ty."

define flow check jailbreak
  $is_jailbreak = execute check_jailbreak(user_message=$user_message)
  if $is_jailbreak
    bot refuse jailbreak
    stop


define bot refuse off topic
  "Xin lỗi, tôi chỉ có thể trả lời các câu hỏi về chính sách nội bộ của công ty như nghỉ phép, lương thưởng, bảo hiểm, và các quy trình HR. Bạn có muốn hỏi về chủ đề đó không?"

define flow check off topic
  $is_off_topic = execute check_off_topic(user_message=$user_message)
  if $is_off_topic
    bot refuse off topic
    stop


define bot refuse pii request
  "Xin lỗi, tôi không thể cung cấp thông tin cá nhân của nhân viên cụ thể. Đây là dữ liệu bảo mật theo chính sách phân loại dữ liệu của công ty."

define flow check pii request
  $is_pii_request = execute check_pii_request(user_message=$user_message)
  if $is_pii_request
    bot refuse pii request
    stop


define bot refuse prompt injection
  "Xin lỗi, tôi phát hiện yêu cầu này có dấu hiệu prompt injection và không thể xử lý. Vui lòng đặt câu hỏi trực tiếp về chính sách nhân sự."

define flow check prompt injection
  $is_prompt_injection = execute check_prompt_injection(user_message=$user_message)
  if $is_prompt_injection
    bot refuse prompt injection
    stop


# ── Output Rails ──────────────────────────────────────────────────────────────
# GHI CHÚ: xem actions.py — flow này dùng execute check_sensitive_output($bot_message)
# thay vì canonical-form `bot provide sensitive output`, vì canonical-form output rail
# luôn khớp bất kể nội dung khi generate_async() được gọi ở chế độ output-only
# (dialog=False, dùng để test 1 câu trả lời cho sẵn — xem check_output_rail()).

define flow check sensitive output
  $is_sensitive = execute check_sensitive_output(bot_message=$bot_message)
  if $is_sensitive
    bot say "Tôi không thể cung cấp thông tin này. Vui lòng liên hệ phòng Nhân sự trực tiếp."
    stop


# ── HR Policy Flows (allowed topics) ──────────────────────────────────────────

define user ask about hr policy
  "nghỉ phép"
  "ngày phép"
  "phép năm"
  "bảo hiểm"
  "lương"
  "thưởng"
  "tạm ứng"
  "công tác"
  "thử việc"
  "đào tạo"
  "VPN"
  "mật khẩu"
  "WFH"
  "làm việc từ xa"
  "phụ cấp"
  "mentor"

# GHI CHÚ: đã bỏ flow "self check facts" (fact-checking dựa trên $facts = execute
# check_facts) khỏi bản gốc. "self check facts" là tên flow reserved của NeMo
# (nemoguardrails/library/self_check/facts) nên dù KHÔNG được khai báo trong
# rails.output.flows của config.yml, nó vẫn tự kích hoạt ở chế độ output-only —
# và vì check_output_rail() không truyền retrieved context ($relevant_chunks)
# cho action check_facts, $facts.accurate luôn rơi về false, khiến flow này
# LUÔN chèn cảnh báo "có thể không chính xác" đè lên message của check_sensitive_output.
# Task 11 chỉ cần kiểm tra PII/nội dung nhạy cảm trong output (đã có check_sensitive_output
# ở trên) — fact-checking cần retrieved context thật, ngoài phạm vi hàm này.
